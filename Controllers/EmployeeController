const EmployeeService = require('../Services/EmployeeService');

async function addEmployee(req, res, next) {
  try
  {
    req.employeeData.organizationId = req.user.organizationId;
    const result = await EmployeeService.addEmployee(req.employeeData);
    res.status(200).json(result);
  }
  catch (err)
  {
    next(err);
  }
}

async function getEmployees(req, res, next) {
  try
  {
    const orgId = req.user.organizationId;
    const result = await EmployeeService.getEmployeesByOrg(orgId);
    res.status(200).json(result);
  }
  catch (err)
  {
    next(err);
  }
}

async function removeEmployee(req, res) {
  try {
    const result = await EmployeeService.removeEmployee(req.params.id);
    res.status(200).json(result);
  } catch (err) {
    res.status(400).json({ message: err.message });
  }
}

module.exports = { addEmployee, getEmployees, removeEmployee };