const EmployeeService = require('../Services/EmployeeService');

async function addEmployee(req, res, next) {
  try
  {
    req.employeeData.organizationId = req.user.orgId;
    const result = await EmployeeService.addEmployee(req.employeeData);
    res.status(200).json(result);
  }
  catch (err)
  {
    next(err);
  }
}

async function getEmployees(req, res, next) {
  try
  {
    const orgId = req.user.orgId;
    const result = await EmployeeService.getEmployeesByOrg(orgId);
    res.status(200).json(result);
  }
  catch (err)
  {
    next(err);
  }
}

module.exports = { addEmployee, getEmployees };